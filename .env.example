# Copiez ce fichier en ".env" puis remplissez-le. Ne le partagez jamais.

PORT=3000
# Adresse publique du site, sans "/" à la fin (utilisée pour le retour de paiement)
BASE_URL=https://www.votre-domaine.com

# Chaîne aléatoire longue (ex. générée avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Mot de passe de l’administrateur (utilisé uniquement à la première exécution, modifiable ensuite dans l’admin)
ADMIN_PASSWORD=

BOUTIQUE=ARAFA TECHNOLOGIE
WHATSAPP=224600000000
META_PIXEL_ID=

# Paiement automatique (Moneroo). Laissez vide pour n’accepter que le paiement à la livraison.
MONEROO_SECRET_KEY=
MONEROO_WEBHOOK_SECRET=
# Domaine utilisé pour créer un e-mail technique si le client n’en donne pas (ex. votre-domaine.com)
FALLBACK_EMAIL_DOMAIN=
